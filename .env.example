# Copy to .env and fill in real values. .env is git-ignored; never commit it.
CLASS_API_KEY=replace-me

# Class service endpoints (OpenAI-compatible vLLM servers)
LLM_BASE_URL=http://example.com:9001/v1
LLM_MODEL=cyankiwi/Qwen3.6-35B-A3B-AWQ-4bit
TEXT_EMBED_BASE_URL=http://example.com:9002/v1
TEXT_EMBED_MODEL=nvidia/Nemotron-3-Embed-1B-BF16
TEXT_EMBED_QUERY_PREFIX="query: "
TEXT_EMBED_PASSAGE_PREFIX="passage: "
VISUAL_EMBED_BASE_URL=http://example.com:9003/v1
VISUAL_EMBED_MODEL=Qwen/Qwen3-VL-Embedding-2B
RERANK_BASE_URL=http://example.com:9004/v1
RERANK_MODEL=Qwen/Qwen3-VL-Reranker-2B
OCR_BASE_URL=http://example.com:9005/v1
OCR_MODEL=dots.mocr

# Where documents, page images and indexes are stored
DATA_DIR=data

# Public sharing (temporary *.gradio.live link: up to a week, best effort, only while this computer runs the app)
SHARE=false
APP_USERNAME=mbax
APP_PASSWORD=replace-me
# Hide upload/remove for visitors (defaults to true when SHARE=true)
READ_ONLY=
